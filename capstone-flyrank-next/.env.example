# Display name of the web application
NEXT_PUBLIC_APP_NAME=ProposalAI

# Base public URL of the application
NEXT_PUBLIC_API_URL=http://localhost:3000

# Supabase project URL (found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous publishable key (found in Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key

# Groq API key for LLM analysis, proposal generation streaming, and scoring
GROQ_API_KEY=gsk_your_groq_api_key

# Default Groq model identifier (fallback if specific generation model is not set)
GROQ_MODEL=openai/gpt-oss-120b

# Optional model override used specifically for proposal generation streaming
GROQ_MODEL_GENERATE=openai/gpt-oss-120b

# Kill switch: set to "true" to temporarily disable all AI endpoints and return 503
AI_DISABLED=false

# Hourly rate limit for job analysis requests per user (default: 10)
AI_LIMIT_ANALYZE_PER_HOUR=10

# Daily rate limit for proposal generation streaming requests per user (default: 30)
AI_LIMIT_GENERATE_PER_DAY=30

# Daily rate limit for proposal scoring requests per user (default: 30)
AI_LIMIT_SCORE_PER_DAY=30
